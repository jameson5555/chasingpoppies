{
  "name": "static-website-template",
  "version": "1.0.1",
  "description": "template for static website",
  "author": "Vincent Will <vincent.will@vaitrade.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vincenius/static-website-template"
  },
  "scripts": {
    "clean": "rimraf dist/*",
    "build:events": "node scripts/generate-site.js source",
    "css:autoprefixer": "postcss -u autoprefixer -r dist/*.css",
    "css:scss": "sass --no-source-map --style=compressed --load-path=node_modules src/scss:dist",
    "css:lint": "stylelint src/scss/*.scss --custom-syntax postcss-scss",
    "build:css": "npm run css:lint && npm run css:scss && npm run css:autoprefixer",
    "build:js": "webpack --mode=production",
    "build:html": "posthtml -c posthtml.json",
    "build:images": "mkdir -p dist/images && cp -R src/images/* dist/images/ || true",
    "build:fonts": "mkdir -p dist/fonts && cp -R src/fonts/* dist/fonts/ || true",
    "build:pages": "node scripts/generate-site.js dist",
    "build": "run-s clean build:events build:css build:js build:html build:images build:fonts build:pages",
    "serve": "http-server dist -p 3000",
    "watch:css": "onchange \"src/scss\" -- npm run build:css",
    "watch:html": "onchange \"src/views\" -- npm run build:html",
    "watch:images": "onchange \"src/images\" -- npm run build:images",
    "watch:js": "onchange \"src/js\" -- webpack --mode=development",
    "watch": "run-p serve watch:*"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.8.4",
    "autoprefixer": "^9.7.4",
    "babel-loader": "^8.0.6",
    "eslint": "^6.8.0",
    "eslint-loader": "^3.0.3",
    "htmlnano": "^0.2.5",
    "http-server": "^14.1.1",
    "imagemin-cli": "^5.1.0",
    "node-sass": "npm:sass@^1.54.3",
    "npm-run-all": "^4.1.5",
    "onchange": "^6.1.0",
    "postcss-cli": "^7.1.0",
    "postcss-scss": "^4.0.9",
    "posthtml": "^0.12.0",
    "posthtml-cli": "^0.5.2",
    "posthtml-modules": "^0.4.2",
    "stylelint": "^14.16.1",
    "webpack": "^4.41.5",
    "webpack-cli": "^3.3.10"
  },
  "dependencies": {
    "bootstrap": "^5.2.3",
    "dart-sass": "^1.25.0"
  },
  "overrides": {
    "yargs-parser": "21.1.0",
    "yargs": "17.7.1"
  }
}
